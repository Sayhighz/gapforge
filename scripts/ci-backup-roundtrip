#!/bin/sh
set -eu

project=gapforge-ci-backup
if command -v python3 >/dev/null 2>&1; then
    python_command=python3
else
    python_command=python
fi
if command -v docker-compose >/dev/null 2>&1; then
    compose() {
        docker-compose -p "$project" "$@"
    }
else
    compose() {
        docker compose -p "$project" "$@"
    }
fi
cleanup() {
    compose down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

export AGENT_PROVIDER=fake
export AUTHOR_HMAC_KEY=ci-test-only-author-hmac-key-32-bytes

# Build the shared application image once. Building migrate and worker together
# makes Compose export the same large image twice and can exhaust small CI runners.
compose build worker
compose up -d postgres
compose run --rm migrate
compose up -d --no-build worker
compose exec -T worker gap mission create \
    "Verify credential-free backup and restore" \
    --title "CI backup sentinel" \
    --output-locale en \
    --json >/dev/null

backup_json=$(compose exec -T worker gap backup create --json)
backup_name=$(printf '%s' "$backup_json" | "$python_command" -c \
    'import json,sys; print(json.load(sys.stdin)["data"]["name"])')
compose exec -T worker gap backup verify "$backup_name" --json >/dev/null
compose exec -T -e PGPASSWORD=gapforge worker \
    dropdb --host postgres --username gapforge --maintenance-db postgres --force gapforge
compose exec -T worker gap backup restore "$backup_name" \
    --target gapforge_restore_ci \
    --yes \
    --json >/dev/null

restored_count=$(compose exec -T -e PGPASSWORD=gapforge worker \
    psql --host postgres --username gapforge --dbname gapforge_restore_ci \
    --tuples-only --no-align \
    --command "SELECT count(*) FROM research_missions WHERE title = 'CI backup sentinel'")
test "$restored_count" = "1"

compose exec -T -e BACKUP_NAME="$backup_name" worker python -c \
    'import os,pathlib; p=pathlib.Path("/var/lib/gapforge/backups")/os.environ["BACKUP_NAME"]; p.write_bytes(p.read_bytes()+b"corrupt")'
if compose exec -T worker gap backup verify "$backup_name" --json >/dev/null 2>&1; then
    echo "corrupt backup unexpectedly verified" >&2
    exit 1
fi
